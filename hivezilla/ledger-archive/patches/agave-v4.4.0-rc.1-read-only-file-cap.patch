 impl BlockstoreOptions {
+    /// Select the file-cache limit without changing primary or default behavior.
+    pub fn max_open_files_for_access(&self) -> std::io::Result<i32> {
+        if self.access_type != AccessType::ReadOnly {
+            return Ok(-1);
+        }
+        match self.read_only_max_open_files {
+            None => Ok(-1),
+            Some(limit) => i32::try_from(limit.get()).map_err(|_| {
+                std::io::Error::new(
+                    std::io::ErrorKind::InvalidInput,
+                    "read-only max_open_files exceeds positive i32",
+                )
+            }),
+        }
+    }
+
     pub fn default_for_tests() -> Self {
         BlockstoreOptions::default()
     }
