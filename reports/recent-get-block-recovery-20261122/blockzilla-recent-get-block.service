[Unit]
Description=Blockzilla read-only recent Compact V2 and archive resolution
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/live/hivezilla-validator-20260930/jobs/recent-get-block-recovery-20261122
ExecStart=/home/ubuntu/live/hivezilla-validator-20260930/jobs/recent-get-block-recovery-20261122/bin/blockzilla-resolution-service --mirror-root /home/ubuntu/data/blockzilla-resolution-indexes/source-v1 --catalog /home/ubuntu/live/hivezilla-validator-20260930/jobs/recent-get-block-recovery-20261122/catalog.json --token-file /home/ubuntu/live/hivezilla-validator-20260930/jobs/recent-get-block-recovery-20261122/broker-token.txt --listen 127.0.0.1:18962 --cache-mib 0 --max-concurrent 8 --recent-config /home/ubuntu/live/hivezilla-validator-20260930/jobs/recent-get-block-recovery-20261122/recent-config.json
